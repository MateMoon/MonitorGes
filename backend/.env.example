DATABASE_URL="postgresql://soporte:soporte@localhost:5432/db_prueba?schema=public"
PORT=3001
HOST=0.0.0.0
TIME_ZONE=America/Santiago
CORS_ORIGINS=http://localhost:8443

# SMTP para pruebas manuales (no se inicia ningún envío automático)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TEST_TO=

# Informe automático diario (permanece apagado hasta habilitarlo explícitamente)
AUTO_EMAIL_ENABLED=false
AUTO_EMAIL_TIME=08:00
# La dirección operativa se configura y guarda desde Alertas en PostgreSQL.
