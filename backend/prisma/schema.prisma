generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  COORDINADOR_SOME
  PROFESIONAL
  LECTOR
}

enum EstadoImportacion {
  COMPLETADA
  COMPLETADA_CON_OBSERVACIONES
  FALLIDA
}

enum EstadoEnvioCorreo {
  EN_PROCESO
  ENVIADO
  FALLIDO
}

enum EstadoGestion {
  SIN_GESTION
  EN_GESTION
  PENDIENTE_RESOLUCION
  CUMPLIDA
}

enum TipoActuacion {
  CONTACTO_PACIENTE
  CITACION
  ATENCION_REALIZADA
  DERIVACION
  SOLICITUD_RESPALDO
  OTRA_GESTION
}

enum TipoEventoGarantia {
  ACTUACION
  CAMBIO_ESTADO
  CUMPLIMIENTO
  REAPERTURA
  ANTECEDENTE_LEGADO
}

model Paciente {
  id         String     @id @default(uuid()) @db.Uuid
  rutNumero  String
  dv         String
  nombre     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  garantias  Garantia[]

  @@unique([rutNumero, dv])
}

model Garantia {
  id                      String    @id @default(uuid()) @db.Uuid
  pacienteId              String    @db.Uuid
  problemaSalud           String
  nombreGarantia          String
  fechaInicio             DateTime  @db.Date
  fechaLimite             DateTime  @db.Date
  responsable             String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  gestionadaAt            DateTime?
  gestionadaPorUsuarioId  String?   @db.Uuid
  version                 Int       @default(1)
  estadoGestion           EstadoGestion @default(SIN_GESTION)
  revisionGestion         Int       @default(0)
  eventos                 EventoGarantia[]
  evidenciasCalidad       EvidenciaCalidad[]
  candidaturasFila        CandidatoFilaImportacion[]
  resultadosFila          FilaImportacion[] @relation("ResultadoFilaImportacion")
  resolucionesFila        ResolucionFilaImportacion[] @relation("ResultadoResolucionFila")
  paciente                Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  gestionadaPor           Usuario?  @relation("Gestionadas", fields: [gestionadaPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([fechaLimite])
  @@index([responsable])
  @@index([pacienteId])
  @@index([estadoGestion, fechaLimite])
}

// Cronología extensible: futuras categorías se agregan sin sustituir eventos anteriores.
model EventoGarantia {
  id              String             @id @default(uuid()) @db.Uuid
  secuencia       Int                @unique @default(autoincrement())
  garantiaId      String             @db.Uuid
  usuarioId       String?            @db.Uuid
  autorNombre     String?
  tipo            TipoEventoGarantia
  tipoActuacion   TipoActuacion?
  comentario      String?
  estadoAnterior  EstadoGestion?
  estadoNuevo     EstadoGestion?
  respaldo        String?
  createdAt       DateTime           @default(now())
  metadatos       Json?
  claveLegado     String?            @unique
  garantia        Garantia           @relation(fields: [garantiaId], references: [id], onDelete: Restrict)
  usuario         Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([garantiaId, createdAt, secuencia])
}

model Usuario {
  id             String        @id @default(uuid()) @db.Uuid
  nombre         String
  nombres        String?
  apellido       String?
  recibirInformeAutomatico Boolean @default(false)
  username       String        @unique
  email          String        @unique
  rol            RolUsuario    @default(LECTOR)
  puedeCargarNominas Boolean    @default(false)
  activo         Boolean       @default(true)
  passwordHash   String?
  ultimoAccesoAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  importaciones  Importacion[]
  garantias      Garantia[]    @relation("Gestionadas")
  sesiones       SesionUsuario[]
  eventosGarantia EventoGarantia[]
  areasResponsabilidad AreaResponsabilidad[] @relation("AreaUsuario")
  areasCreadas   AreaResponsabilidad[] @relation("AreaCreador")
  areasActualizadas AreaResponsabilidad[] @relation("AreaActualizador")
  tiposGarantia  UsuarioTipoGarantia[]
  reglasAsignacion Json?
  informesIndividuales EnvioInformeIndividual[]
  casosCalidadCreados CasoCalidad[]
  eventosCalidad EventoCalidad[]
  resolucionesFila ResolucionFilaImportacion[]
}

enum EstadoInformeIndividual {
  RESERVADO
  EN_PROCESO
  ACEPTADO_SMTP
  FALLIDO
  OMITIDO
  INCIERTO
}

model EnvioInformeIndividual {
  id               String @id @default(uuid()) @db.Uuid
  usuarioId        String @db.Uuid
  fechaInforme     DateTime @db.Date
  claveEjecucion    String @default("diario")
  destinatario     String
  huellaConfiguracion String
  tokenReserva     String @db.Uuid
  estado           EstadoInformeIndividual @default(RESERVADO)
  intentos         Int @default(1)
  iniciadoAt       DateTime @default(now())
  finalizadoAt     DateTime?
  aceptadoSmtpAt   DateTime?
  cantidadGarantias Int @default(0)
  codigoResultado  String?
  reintentable     Boolean @default(false)
  messageId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  usuario          Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  intentosDetalle  IntentoInformeIndividual[]

  @@unique([usuarioId, fechaInforme, claveEjecucion], map: "EnvioInformeIndividual_usuario_fecha_ejecucion_key")
  @@index([fechaInforme, estado])
}

model IntentoInformeIndividual {
  id               String @id @default(uuid()) @db.Uuid
  envioId          String @db.Uuid
  numero           Int
  estado           EstadoInformeIndividual @default(RESERVADO)
  iniciadoAt       DateTime @default(now())
  finalizadoAt     DateTime?
  aceptadoSmtpAt   DateTime?
  cantidadGarantias Int @default(0)
  codigoResultado  String?
  reintentable     Boolean @default(false)
  messageId        String?
  envio            EnvioInformeIndividual @relation(fields: [envioId], references: [id], onDelete: Restrict)

  @@unique([envioId, numero])
}

// Identidad exclusivamente por nombre, independiente de las combinaciones de áreas.
model NombreGarantiaAsignable {
  claveNormalizada String @id
  nombre           String
  usuarios         UsuarioTipoGarantia[]
}

model UsuarioTipoGarantia {
  usuarioId        String @db.Uuid
  claveNormalizada String
  usuario          Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipoGarantia     NombreGarantiaAsignable @relation(fields: [claveNormalizada], references: [claveNormalizada], onDelete: Restrict)

  @@id([usuarioId, claveNormalizada])
  @@index([claveNormalizada])
}

model Establecimiento {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @unique
  claveNormalizada String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  areas           AreaResponsabilidad[]

  @@index([activo, nombre])
  @@index([claveNormalizada])
}

model ProblemaSalud {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @unique
  claveNormalizada String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  combinaciones   CombinacionProblemaGarantia[]

  @@index([activo, nombre])
  @@index([claveNormalizada])
}

model TipoGarantia {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @unique
  claveNormalizada String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  combinaciones   CombinacionProblemaGarantia[]

  @@index([activo, nombre])
  @@index([claveNormalizada])
}

model CombinacionProblemaGarantia {
  id             String       @id @default(uuid()) @db.Uuid
  problemaSaludId String      @db.Uuid
  tipoGarantiaId String       @db.Uuid
  activa         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  problemaSalud  ProblemaSalud @relation(fields: [problemaSaludId], references: [id], onDelete: Restrict)
  tipoGarantia   TipoGarantia  @relation(fields: [tipoGarantiaId], references: [id], onDelete: Restrict)
  areas          AreaResponsabilidad[]

  @@unique([problemaSaludId, tipoGarantiaId], map: "CombinacionProblemaGarantia_pair_key")
  @@index([activa])
}

model AreaResponsabilidad {
  id              String                      @id @default(uuid()) @db.Uuid
  usuarioId       String                      @db.Uuid
  establecimientoId String                    @db.Uuid
  combinacionId   String                      @db.Uuid
  activa          Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  creadorId       String?                     @db.Uuid
  actualizadorId  String?                     @db.Uuid
  usuario         Usuario                    @relation("AreaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  establecimiento Establecimiento            @relation(fields: [establecimientoId], references: [id], onDelete: Restrict)
  combinacion     CombinacionProblemaGarantia @relation(fields: [combinacionId], references: [id], onDelete: Restrict)
  creador         Usuario?                   @relation("AreaCreador", fields: [creadorId], references: [id], onDelete: SetNull)
  actualizador    Usuario?                   @relation("AreaActualizador", fields: [actualizadorId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, establecimientoId, combinacionId], map: "AreaResponsabilidad_coverage_key")
  @@index([usuarioId, activa])
  @@index([establecimientoId, combinacionId, activa], map: "AreaResponsabilidad_scope_idx")
}


model SesionUsuario {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  usuarioId   String   @db.Uuid
  expiraAt    DateTime
  createdAt   DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraAt])
  @@index([expiraAt])
}

model Importacion {
  id                    String             @id @default(uuid()) @db.Uuid
  nombreArchivo         String
  fechaImportacion      DateTime           @default(now())
  usuarioId             String?            @db.Uuid
  estado                EstadoImportacion
  registrosLeidos       Int                @default(0)
  registrosNuevos       Int                @default(0)
  registrosActualizados Int                @default(0)
  registrosSinCambios   Int                @default(0)
  registrosConError     Int                @default(0)
  usuario               Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  errores               ErrorImportacion[]
  filasRevision         FilaImportacion[]
  controlRetencion      ControlRetencionImportacion?

  @@index([fechaImportacion])
}

model ErrorImportacion {
  id            String      @id @default(uuid()) @db.Uuid
  importacionId String      @db.Uuid
  numeroFila    Int
  codigo        String
  mensaje       String
  datosFila     Json?
  importacion   Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId, numeroFila])
}

model EnvioInformeCorreo {
  id              String            @id @default(uuid()) @db.Uuid
  fechaInforme    DateTime          @db.Date
  destinatario    String
  estado          EstadoEnvioCorreo @default(EN_PROCESO)
  intentos        Int               @default(1)
  iniciadoAt      DateTime          @default(now())
  enviadoAt       DateTime?
  messageId       String?
  codigoError     String?
  operacionError  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  intentosDetalle IntentoEnvioCorreo[]

  @@unique([fechaInforme])
  @@index([estado, iniciadoAt])
}

model IntentoEnvioCorreo {
  id             String            @id @default(uuid()) @db.Uuid
  envioId        String            @db.Uuid
  numero         Int
  estado         EstadoEnvioCorreo @default(EN_PROCESO)
  iniciadoAt     DateTime          @default(now())
  finalizadoAt   DateTime?
  messageId      String?
  codigoError    String?
  operacionError String?
  envio          EnvioInformeCorreo @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@unique([envioId, numero])
  @@index([envioId, iniciadoAt])
}

model ConfiguracionNotificaciones {
  id                 String   @id
  emailDestinatario  String?
  emailDestinatarios String[] @default([])
  updatedAt          DateTime @updatedAt
}

enum EstadoCasoCalidad {
  PENDIENTE
  ANTECEDENTES
  RESUELTO
}

enum OrigenCasoCalidad {
  APLICACION
  EXCEL
}

enum DecisionCalidad {
  MISMA_GARANTIA
  GARANTIAS_DIFERENTES
  NECESITA_ANTECEDENTES
  FILA_INCORRECTA
}

enum TipoEventoCalidad {
  DETECCION
  REUTILIZACION
  SOLICITUD_ANTECEDENTES
  DECISION
}

model CasoCalidad {
  id             String @id @default(uuid()) @db.Uuid
  origen         OrigenCasoCalidad
  motivo         String
  estado         EstadoCasoCalidad @default(PENDIENTE)
  version        Int @default(1)
  huella         String @db.VarChar(64)
  claveAbierta   String? @unique @db.VarChar(64)
  nombreArchivo  String? @db.VarChar(255)
  huellaArchivo  String? @db.VarChar(64)
  numeroFila     Int?
  diferencias    String[] @default([])
  creadoPorId    String @db.Uuid
  detectadoAt    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  creadoPor      Usuario @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  evidencias     EvidenciaCalidad[]
  eventos        EventoCalidad[]

  @@index([estado, createdAt, id])
  @@index([origen, motivo])
}

model EvidenciaCalidad {
  id                  String @id @default(uuid()) @db.Uuid
  casoId              String @db.Uuid
  posicion            Int
  tipo                String
  garantiaId          String? @db.Uuid
  datos               Json
  huella              String @db.VarChar(64)
  versionGarantia     Int?
  revisionGestion     Int?
  createdAt           DateTime @default(now())
  caso                CasoCalidad @relation(fields: [casoId], references: [id], onDelete: Restrict)
  garantia            Garantia? @relation(fields: [garantiaId], references: [id], onDelete: Restrict)

  @@unique([casoId, posicion])
  @@index([garantiaId])
}

model EventoCalidad {
  id              String @id @default(uuid()) @db.Uuid
  secuencia       Int @unique @default(autoincrement())
  casoId          String @db.Uuid
  usuarioId       String @db.Uuid
  autorNombre     String
  tipo            TipoEventoCalidad
  decision        DecisionCalidad?
  estadoAnterior  EstadoCasoCalidad?
  estadoNuevo     EstadoCasoCalidad
  justificacion   String?
  antecedentes    String?
  observacion     String?
  solicitudId     String @unique @db.Uuid
  huellaSolicitud String @db.VarChar(64)
  createdAt       DateTime @default(now())
  caso            CasoCalidad @relation(fields: [casoId], references: [id], onDelete: Restrict)
  usuario         Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([casoId, createdAt, secuencia])
}

// Nuevo flujo de importación. Los modelos documentales anteriores siguen intactos.
enum EstadoFilaImportacion {
  PENDIENTE
  RESUELTA
}

enum DecisionFilaImportacion {
  MISMA
  DISTINTA
}

// Separate table keeps the disabled importer compatible with the previous DB.
// resultados contains only row numbers and outcomes, never source clinical data.
model ControlRetencionImportacion {
  importacionId              String     @id @db.Uuid
  solicitudId                String     @unique @db.Uuid
  huellaArchivo              String     @db.VarChar(64)
  versionPolitica            String     @db.VarChar(64)
  registrosPendientesRevision Int        @default(0)
  registrosRepetidosOmitidos  Int        @default(0)
  registrosInvalidos         Int        @default(0)
  resultados                Json       @default("{}")
  completada                Boolean    @default(false)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  importacion               Importacion @relation(fields: [importacionId], references: [id], onDelete: Restrict)
}

model FilaImportacion {
  id                  String @id @default(uuid()) @db.Uuid
  importacionId       String @db.Uuid
  hoja                String @db.VarChar(255)
  numeroFila          Int
  datosValidados      Json
  motivos             String[]
  versionPolitica     String @db.VarChar(64)
  estado              EstadoFilaImportacion @default(PENDIENTE)
  version             Int @default(1)
  huellaFila          String @db.VarChar(64)
  huellaDatos         String @db.VarChar(64)
  huellaCandidatos    String @db.VarChar(64)
  garantiaResultadoId String? @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  importacion         Importacion @relation(fields: [importacionId], references: [id], onDelete: Restrict)
  garantiaResultado   Garantia? @relation("ResultadoFilaImportacion", fields: [garantiaResultadoId], references: [id], onDelete: Restrict)
  candidatos          CandidatoFilaImportacion[]
  resolucion          ResolucionFilaImportacion?

  @@unique([importacionId, hoja, numeroFila], map: "FilaImportacion_origen_key")
  @@unique([id, garantiaResultadoId], map: "FilaImportacion_resultado_key")
  @@index([estado, createdAt, id])
  @@index([garantiaResultadoId])
}

model CandidatoFilaImportacion {
  filaId           String @db.Uuid
  garantiaId       String @db.Uuid
  datos            Json
  huella           String @db.VarChar(64)
  versionGarantia  Int
  revisionGestion Int
  createdAt        DateTime @default(now())
  fila             FilaImportacion @relation(fields: [filaId], references: [id], onDelete: Restrict)
  garantia         Garantia @relation(fields: [garantiaId], references: [id], onDelete: Restrict)

  @@id([filaId, garantiaId])
  @@index([garantiaId])
}

model ResolucionFilaImportacion {
  id                  String @id @default(uuid()) @db.Uuid
  filaId              String @unique @db.Uuid
  decision            DecisionFilaImportacion
  usuarioId           String @db.Uuid
  autorNombre         String
  justificacion       String
  solicitudId         String @unique @db.Uuid
  huellaSolicitud     String @db.VarChar(64)
  antecedentesRevisados Json?
  garantiaResultadoId String @db.Uuid
  createdAt           DateTime @default(now())
  fila                FilaImportacion @relation(fields: [filaId, garantiaResultadoId], references: [id, garantiaResultadoId], onDelete: Restrict, onUpdate: Restrict)
  usuario             Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  garantiaResultado   Garantia @relation("ResultadoResolucionFila", fields: [garantiaResultadoId], references: [id], onDelete: Restrict)

  @@unique([filaId, garantiaResultadoId], map: "ResolucionFilaImportacion_resultado_key")
  @@index([createdAt, id])
  @@index([garantiaResultadoId])
}
