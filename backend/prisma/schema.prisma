generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  COORDINADOR_SOME
  PROFESIONAL
  LECTOR
}

enum EstadoImportacion {
  COMPLETADA
  COMPLETADA_CON_OBSERVACIONES
  FALLIDA
}

enum EstadoEnvioCorreo {
  EN_PROCESO
  ENVIADO
  FALLIDO
}

enum EstadoGestion {
  SIN_GESTION
  EN_GESTION
  PENDIENTE_RESOLUCION
  CUMPLIDA
}

enum TipoActuacion {
  CONTACTO_PACIENTE
  CITACION
  ATENCION_REALIZADA
  DERIVACION
  SOLICITUD_RESPALDO
  OTRA_GESTION
}

enum TipoEventoGarantia {
  ACTUACION
  CAMBIO_ESTADO
  CUMPLIMIENTO
  REAPERTURA
  ANTECEDENTE_LEGADO
}

model Paciente {
  id         String     @id @default(uuid()) @db.Uuid
  rutNumero  String
  dv         String
  nombre     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  garantias  Garantia[]

  @@unique([rutNumero, dv])
}

model Garantia {
  id                      String    @id @default(uuid()) @db.Uuid
  pacienteId              String    @db.Uuid
  problemaSalud           String
  nombreGarantia          String
  fechaInicio             DateTime  @db.Date
  fechaLimite             DateTime  @db.Date
  responsable             String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  gestionadaAt            DateTime?
  gestionadaPorUsuarioId  String?   @db.Uuid
  version                 Int       @default(1)
  estadoGestion           EstadoGestion @default(SIN_GESTION)
  revisionGestion         Int       @default(0)
  eventos                 EventoGarantia[]
  paciente                Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  gestionadaPor           Usuario?  @relation("Gestionadas", fields: [gestionadaPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([fechaLimite])
  @@index([responsable])
  @@index([pacienteId])
  @@index([estadoGestion, fechaLimite])
}

// Cronología extensible: futuras categorías se agregan sin sustituir eventos anteriores.
model EventoGarantia {
  id              String             @id @default(uuid()) @db.Uuid
  secuencia       Int                @unique @default(autoincrement())
  garantiaId      String             @db.Uuid
  usuarioId       String?            @db.Uuid
  autorNombre     String?
  tipo            TipoEventoGarantia
  tipoActuacion   TipoActuacion?
  comentario      String?
  estadoAnterior  EstadoGestion?
  estadoNuevo     EstadoGestion?
  respaldo        String?
  createdAt       DateTime           @default(now())
  metadatos       Json?
  claveLegado     String?            @unique
  garantia        Garantia           @relation(fields: [garantiaId], references: [id], onDelete: Restrict)
  usuario         Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([garantiaId, createdAt, secuencia])
}

model Usuario {
  id             String        @id @default(uuid()) @db.Uuid
  nombre         String
  username       String        @unique
  email          String        @unique
  rol            RolUsuario    @default(LECTOR)
  puedeCargarNominas Boolean    @default(false)
  activo         Boolean       @default(true)
  passwordHash   String?
  ultimoAccesoAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  importaciones  Importacion[]
  garantias      Garantia[]    @relation("Gestionadas")
  sesiones       SesionUsuario[]
  eventosGarantia EventoGarantia[]
  areasResponsabilidad AreaResponsabilidad[] @relation("AreaUsuario")
  areasCreadas   AreaResponsabilidad[] @relation("AreaCreador")
  areasActualizadas AreaResponsabilidad[] @relation("AreaActualizador")
}

model Establecimiento {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @unique
  claveNormalizada String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  areas           AreaResponsabilidad[]

  @@index([activo, nombre])
  @@index([claveNormalizada])
}

model ProblemaSalud {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @unique
  claveNormalizada String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  combinaciones   CombinacionProblemaGarantia[]

  @@index([activo, nombre])
  @@index([claveNormalizada])
}

model TipoGarantia {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @unique
  claveNormalizada String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  combinaciones   CombinacionProblemaGarantia[]

  @@index([activo, nombre])
  @@index([claveNormalizada])
}

model CombinacionProblemaGarantia {
  id             String       @id @default(uuid()) @db.Uuid
  problemaSaludId String      @db.Uuid
  tipoGarantiaId String       @db.Uuid
  activa         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  problemaSalud  ProblemaSalud @relation(fields: [problemaSaludId], references: [id], onDelete: Restrict)
  tipoGarantia   TipoGarantia  @relation(fields: [tipoGarantiaId], references: [id], onDelete: Restrict)
  areas          AreaResponsabilidad[]

  @@unique([problemaSaludId, tipoGarantiaId], map: "CombinacionProblemaGarantia_pair_key")
  @@index([activa])
}

model AreaResponsabilidad {
  id              String                      @id @default(uuid()) @db.Uuid
  usuarioId       String                      @db.Uuid
  establecimientoId String                    @db.Uuid
  combinacionId   String                      @db.Uuid
  activa          Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  creadorId       String?                     @db.Uuid
  actualizadorId  String?                     @db.Uuid
  usuario         Usuario                    @relation("AreaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  establecimiento Establecimiento            @relation(fields: [establecimientoId], references: [id], onDelete: Restrict)
  combinacion     CombinacionProblemaGarantia @relation(fields: [combinacionId], references: [id], onDelete: Restrict)
  creador         Usuario?                   @relation("AreaCreador", fields: [creadorId], references: [id], onDelete: SetNull)
  actualizador    Usuario?                   @relation("AreaActualizador", fields: [actualizadorId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, establecimientoId, combinacionId], map: "AreaResponsabilidad_coverage_key")
  @@index([usuarioId, activa])
  @@index([establecimientoId, combinacionId, activa], map: "AreaResponsabilidad_scope_idx")
}


model SesionUsuario {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  usuarioId   String   @db.Uuid
  expiraAt    DateTime
  createdAt   DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraAt])
  @@index([expiraAt])
}

model Importacion {
  id                    String             @id @default(uuid()) @db.Uuid
  nombreArchivo         String
  fechaImportacion      DateTime           @default(now())
  usuarioId             String?            @db.Uuid
  estado                EstadoImportacion
  registrosLeidos       Int                @default(0)
  registrosNuevos       Int                @default(0)
  registrosActualizados Int                @default(0)
  registrosSinCambios   Int                @default(0)
  registrosConError     Int                @default(0)
  usuario               Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  errores               ErrorImportacion[]

  @@index([fechaImportacion])
}

model ErrorImportacion {
  id            String      @id @default(uuid()) @db.Uuid
  importacionId String      @db.Uuid
  numeroFila    Int
  codigo        String
  mensaje       String
  datosFila     Json?
  importacion   Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId, numeroFila])
}

model EnvioInformeCorreo {
  id              String            @id @default(uuid()) @db.Uuid
  fechaInforme    DateTime          @db.Date
  destinatario    String
  estado          EstadoEnvioCorreo @default(EN_PROCESO)
  intentos        Int               @default(1)
  iniciadoAt      DateTime          @default(now())
  enviadoAt       DateTime?
  messageId       String?
  codigoError     String?
  operacionError  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  intentosDetalle IntentoEnvioCorreo[]

  @@unique([fechaInforme])
  @@index([estado, iniciadoAt])
}

model IntentoEnvioCorreo {
  id             String            @id @default(uuid()) @db.Uuid
  envioId        String            @db.Uuid
  numero         Int
  estado         EstadoEnvioCorreo @default(EN_PROCESO)
  iniciadoAt     DateTime          @default(now())
  finalizadoAt   DateTime?
  messageId      String?
  codigoError    String?
  operacionError String?
  envio          EnvioInformeCorreo @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@unique([envioId, numero])
  @@index([envioId, iniciadoAt])
}

model ConfiguracionNotificaciones {
  id                 String   @id
  emailDestinatario  String?
  emailDestinatarios String[] @default([])
  updatedAt          DateTime @updatedAt
}
