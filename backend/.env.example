DATABASE_URL="postgresql://soporte:soporte@localhost:5432/db_prueba?schema=public"
PORT=3001
HOST=0.0.0.0
TIME_ZONE=America/Santiago
CORS_ORIGINS=http://localhost:8443

# SMTP para pruebas manuales (no se inicia ningún envío automático)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TEST_TO=

# Informe automático diario (permanece apagado hasta habilitarlo explícitamente)
AUTO_EMAIL_ENABLED=false
AUTO_EMAIL_TIME=08:00
# Por defecto true. Solo QA: false permite una nueva ejecución al configurar otra hora.
# El mismo horario conserva su reserva entre sondeos y reinicios.
EMAIL_DEDUP_ENABLED=true
# Los destinatarios y tipos se configuran por cuenta en Gestión de usuarios; Alertas conserva la lista histórica.
